// Tajer ERD v0. Paste into https://dbdiagram.io/d
// One schema per module. Tables in DIFFERENT modules reference each other by Id only,
// with no foreign key across modules (each module owns its tables).

Table catalog.products {
  id uniqueidentifier [pk]
  vendor_id uniqueidentifier [not null, note: 'Identity module. Id only, no FK']
  category_id uniqueidentifier
  name nvarchar(200) [not null]
  description nvarchar(max)
  created_at datetime2 [not null]
}

Table catalog.variants {
  id uniqueidentifier [pk]
  product_id uniqueidentifier [not null, ref: > catalog.products.id]
  sku varchar(64) [not null, unique]
  color nvarchar(50)
  size nvarchar(20)
  price_minor bigint [not null, note: 'Money in minor units (piasters), never decimal or double']
  currency char(3) [not null]
}

